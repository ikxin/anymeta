# GitHub App 设置页中的数字 App ID，不是 Client ID。
NUXT_GITHUB_APP_ID=123456

# GitHub App 生成并下载的 PEM 私钥内容。
# 本地 .env 文件使用双引号，并将换行写成 \n。
NUXT_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nREPLACE_WITH_YOUR_PRIVATE_KEY\n-----END RSA PRIVATE KEY-----"

# 可选。OpenCollective 个人工作区“开发者设置”中创建的 Personal Token。
# 不要添加 NUXT_PUBLIC_ 前缀，也不要提交真实 token。
NUXT_OPEN_COLLECTIVE_TOKEN=
